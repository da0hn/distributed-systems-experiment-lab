.idea
*.iml

# Build do reactor Maven
target/

# Build do frontend. O package-lock.json entra no Git de propósito: o
# workflow usa `npm ci`, que o exige, e sem ele duas execuções do pipeline
# instalariam árvores de dependência diferentes.
frontend/node_modules/
frontend/dist/

# Configuração local de máquina (allowlist de permissões, output style).
.claude/settings.local.json

# Worktrees efêmeras criadas pelo harness. O diretório carrega um arquivo
# `.git`, e um `git add -A` distraído o transformaria em gitlink.
.claude/worktrees/

# Bytecode dos scripts das skills
__pycache__/

# Cache incremental
graphify-out/cache/

# Estado local
graphify-out/memory/
graphify-out/reflections/

# Métricas de custo
graphify-out/cost.json

# Metadados internos
graphify-out/.graphify_*

# Backups automáticos
graphify-out/????-??-??/

# Arquivos temporários (caso existam)
graphify-out/**/*.tmp
graphify-out/**/*.bak
