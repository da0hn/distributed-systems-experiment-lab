root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# A convenção de ADR deste repositório exige linhas de prosa quebradas em ~88 colunas.
# Ela vive aqui, e não no code style da IDE, para sobreviver a outra máquina e a outro
# editor. O IntelliJ dá precedência ao EditorConfig sobre o scheme do projeto e o global.
#
# Tabelas e blocos de código não são quebrados pelo right margin — o formatador só
# aplica hard wrap a parágrafos de prosa. Linhas de tabela acima de 88 colunas são
# esperadas e corretas; quem as governa é ij_markdown_format_tables, que alinha as
# células com padding.
[*.md]
max_line_length = 88
trim_trailing_whitespace = false
ij_markdown_wrap_text_if_long = true
ij_markdown_wrap_text_inside_blockquotes = true
ij_markdown_format_tables = true
ij_markdown_force_one_space_between_words = true
ij_markdown_force_one_space_after_header_symbol = true
ij_markdown_force_one_space_after_list_bullet = true
ij_markdown_force_one_space_after_blockquote_symbol = true
ij_markdown_keep_indents_on_empty_lines = false
ij_markdown_max_lines_around_header = 1
ij_markdown_min_lines_around_header = 1
ij_markdown_max_lines_around_block_elements = 1
ij_markdown_min_lines_around_block_elements = 1

[*.{yml,yaml}]
indent_size = 2

[*.xml]
indent_size = 2
