<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.0</version>
    <relativePath/>
  </parent>

  <groupId>dev.da0hn.lab</groupId>
  <artifactId>distributed-consistency-lab</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>distributed-consistency-lab</name>
  <description>
    Plataforma experimental para reproduzir, observar e comparar problemas
    conhecidos de sistemas distribuidos. A separacao dos modulos segue o
    ADR-0008: o Lab Plane e o system under test rodam em processos separados,
    e o primeiro segmento depois da raiz do pacote nomeia a regiao.
  </description>

  <modules>
    <module>shared</module>
    <module>lab-plane</module>
    <module>lab-journal</module>
    <module>system-under-test</module>
  </modules>

  <properties>
    <java.version>25</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <testcontainers.version>2.0.5</testcontainers.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>dev.da0hn.lab</groupId>
        <artifactId>shared</artifactId>
        <version>${project.version}</version>
      </dependency>
      <!--
        O spring-boot-dependencies 4.x nao gerencia mais as versoes do
        Testcontainers, entao o BOM dele entra explicitamente.
      -->
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
